'--root=[Workspace root override (default\: walk up from cwd)]:DIR:_files -/' \
'--config=[Explicit path to do-harness.toml]:FILE:_files' \
'--color=[Color output (auto, always, never)]:WHEN:_default' \
'--output=[Default output file path]:FILE:_files' \
'*-v[Verbosity level (-v, -vv)]' \
'*--verbose[Verbosity level (-v, -vv)]' \
'-q[Suppress non-error messages]' \
'--quiet[Suppress non-error messages]' \
'--dry-run[Dry run without side effects]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_do-harness_commands" \
"*::: :->do-harness" \
&& ret=0
    case $state in
    (do-harness)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:do-harness-command-$line[1]:"
        case $line[1] in
            (version)
_arguments "${_arguments_options[@]}" : \
'--format=[Output format]:FORMAT:((text\:"Human-readable text output"
json\:"Machine-readable JSON output"))' \
'--root=[Workspace root override (default\: walk up from cwd)]:DIR:_files -/' \
