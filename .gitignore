# Build output
/target
**/*.rs.bk

# Local harness state (libSQL database, per-workspace telemetry)
.do-harness/
.agents/events/
# Task-board export is a per-clone projection of the libSQL source of truth;
# autoincrement ids and mutable status churn make it unmergeable across
# branches. Read it locally via `do-harness task export`.
/plans/tasks.json

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Local agent session state
.opencode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local guardian-proxy runtime state (never commit live configs or audit logs)
guardian-proxy.toml
guardian-audit.jsonl
**/guardian-proxy.toml
**/guardian-audit.jsonl
