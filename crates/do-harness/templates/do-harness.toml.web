# do-harness.toml — web sensor pack for this workspace.
#
# Generated by `do-harness init --language web`. The three runners live in
# scripts/ and the web-ui audit library in scripts/web-ui/; both are committed
# with the workspace so local evidence and CI run the identical code. The
# runners print "SKIP:" and exit 0 when Playwright is missing or
# WEB_AUDIT_ROUTES is unset (verify reports WARN; --strict promotes it), and
# fail closed on real findings. Point WEB_AUDIT_BASE_URL at your dev or
# preview server and WEB_AUDIT_ROUTES at the routes to audit.
language = "web"

[hooks]
pre-commit = []
pre-push = []

[signal-sets]
feedback = ["web-ui-tests"]
verification = ["web-ui-tests", "viewport-ux", "a11y", "console", "perf"]

[[sensors]]
name = "web-ui-tests"
argv = ["node", "--test", "scripts/web-ui/audit.test.mjs"]
when-changed = ["scripts/web-ui/**"]

[[sensors]]
name = "viewport-ux"
argv = ["node", "scripts/viewport-audit.mjs"]
when-changed = ["apps/web/**", "packages/ui/**", "src/**", "scripts/web-ui/**"]

[[sensors]]
name = "a11y"
argv = ["node", "scripts/a11y-audit.mjs"]
when-changed = ["apps/web/**", "packages/ui/**", "src/**", "scripts/web-ui/**"]

[[sensors]]
name = "console"
argv = ["node", "scripts/console-audit.mjs"]
when-changed = ["apps/web/**", "src/**", "scripts/web-ui/**"]

[[sensors]]
name = "perf"
argv = ["node", "scripts/perf-audit.mjs"]
when-changed = ["apps/web/**", "src/**", "packages/ui/**", "scripts/web-ui/**", "**/vite.config.*", "**/next.config.*"]

# Add your repo's own sensors below (typecheck/lint/test wrap the same
# commands CI runs — see docs/adoption.md "Configure sensors for your stack").
