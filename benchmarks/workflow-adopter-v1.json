      "test_argv": ["node", "--test"]
    }
  ],
  "cases": [
    {
      "id": "adopter-rust-filter-order",
      "project_id": "rust-buildlog",
      "scenario": "multi-file-filter-fix",
      "description": "The component and severity filters work, but records are reported in reverse order and severity counts come from the unfiltered log. Fix filter.rs to preserve input order and fix summary.rs (with main.rs) so counts reflect only the retained records. Keep existing parsing, substring matching, empty-input and exit-code behavior intact.",
      "expected_outcome": "changed",
      "grader_id": "adopter-rust-filter-order",
      "variants": {
        "src/filter.rs": "variants/adopter-filter-reversed.rs",
        "src/summary.rs": "variants/adopter-summary-all-counts.rs",
        "src/main.rs": "variants/adopter-main-passes-all.rs"
      },
      "control": [
        {
          "src/filter.rs": "health:src/filter.rs"
        },
        {
          "src/summary.rs": "health:src/summary.rs",
          "src/main.rs": "health:src/main.rs"
        }
      ],
      "treatment": [
        {
          "src/filter.rs": "health:src/filter.rs"
        },
        {
          "src/summary.rs": "health:src/summary.rs",
          "src/main.rs": "health:src/main.rs"
        }
      ]
    },
    {
      "id": "adopter-rust-stale-edit",
      "project_id": "rust-buildlog",
      "scenario": "source-edit-after-green",
      "description": "The repository is fully green. A source edit to parser.rs changes preserved behavior (WARN records become ERROR). Re-run verification after the edit; the regression must be detected and stale green must never be reported as success.",
      "expected_outcome": "unresolved",
      "grader_id": "adopter-rust-stale-edit",
      "variants": {},
      "control": [
        {
          "src/parser.rs": "variant:variants/adopter-parser-warn-mislabeled.rs"
