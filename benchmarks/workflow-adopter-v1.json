  "projects": [
    {
      "id": "rust-buildlog",
      "fixture": "benchmarks/fixtures/workflow-adopter-v1/rust",
      "build_argv": ["cargo", "build", "--offline", "--locked", "--manifest-path", "Cargo.toml"],
      "test_argv": ["cargo", "test", "--offline", "--locked", "--manifest-path", "Cargo.toml"]
    },
    {
      "id": "node-buildlog",
      "fixture": "benchmarks/fixtures/workflow-adopter-v1/node",
